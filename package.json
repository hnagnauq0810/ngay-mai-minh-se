{
  "name": "ngay-mai-minh-se",
  "version": "1.3.0",
  "private": true,
  "description": "Cinematic Vietnamese historical storytelling, 1930–2026 (55 scenes, 12 chapters)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate": "python scripts/validate_content.py",
    "generate": "python scripts/build_site.py",
    "test:release": "python scripts/validate_content.py --release",
    "test:browser": "python tests/e2e_smoke.py",
    "test:cinema": "python tests/cinema_smoke.py",
    "test:audio": "python tests/audio_playback.py",
    "test:story-media": "python tests/story_media_playback.py",
    "test:visual-variety": "python tests/visual_variety.py",
    "test:media-recovery": "python tests/media_recovery.py",
    "validate:storyboards": "python scripts/validate_storyboards.py",
    "audio:story": ".venv-voice/Scripts/python.exe scripts/generate_voice_vieneu.py",
    "audio:generate": "python scripts/generate_voice_edge.py",
    "audio:plan": "python scripts/generate_voice_edge.py --dry-run",
    "audio:fpt:plan": "python scripts/generate_voice_fpt.py --dry-run"
  },
  "dependencies": {
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
